# Copy to .env and fill in. Never commit .env.
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=SVC_OPENFLOW_URI_SYNC
SNOWFLAKE_ROLE=OPENFLOW_URI_SYNC_ROLE
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_PAT=<token_secret from sql/02_create_pat.sql>

SYNC_TABLE=<DB>.<SCHEMA>.MONGODB_CLUSTER_NODES
OPENFLOW_DEPLOYMENT=<deployment name>
OPENFLOW_RUNTIME=<runtime name>
OPENFLOW_CONNECTOR=<connector process group name>
OPENFLOW_PARAMETER=MongoDB Connection URI
# OPENFLOW_RUNTIME_URL=https://<host>/<runtime-key>/nifi-api   # optional override

# true = write the parameter, anything else = dry run
SYNC_APPLY=false
